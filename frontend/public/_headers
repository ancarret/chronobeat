/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://*.mzstatic.com; media-src https://audio-ssl.itunes.apple.com; connect-src 'self' https://chronobeat-backend-y9vn.onrender.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Runtime config written at build time (scripts/write-env.mjs): never serve a stale copy.
/env.js
  Cache-Control: no-cache
