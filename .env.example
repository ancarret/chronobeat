# Copy to .env (or export these directly) for a docker-compose run that
# deviates from the defaults baked into docker-compose.yml, or use this as a
# reference for configuring the backend/frontend on Render/Neon/Cloudflare Pages.
# Never commit a real .env file - it's gitignored on purpose.

# --- Backend: database (Neon gives you a JDBC-formatted connection string) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/chronobeat
DATABASE_USERNAME=chronobeat
DATABASE_PASSWORD=chronobeat

# --- Backend: CORS -----------------------------------------------------
# Exact origin(s) of the deployed frontend. No wildcard in production.
FRONTEND_URL=http://localhost:4200

# --- Backend: catalog admin ---------------------------------------------
# Shared secret required in the X-Admin-Key header for POST /api/admin/catalog/*.
ADMIN_INGEST_KEY=change-me-in-production

# --- Backend: music provider ---------------------------------------------
MUSIC_PROVIDER=apple
APPLE_API_BASE_URL=https://itunes.apple.com

# --- Backend: runtime ----------------------------------------------------
# local (default) | prod. See backend/src/main/resources/application-*.yml.
SPRING_PROFILES_ACTIVE=local
PORT=8080

# --- Frontend: at container/deploy time, generated into env.js -----------
# Must be reachable from the PLAYER'S BROWSER, not just from inside a Docker
# network - so http://backend:8080 (a Docker-internal hostname) will not work.
API_BASE_URL=http://localhost:8080
